@{
    ViewData["Title"] = "Book Details";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #faf6ee;
    }

    .shelf-heading {
        font-family: 'Calisto MT', serif;
        color: #4d4835;
        font-weight: 700;
    }

    .nook-card {
        background-color: #faf6ee;
        border: 1px solid #c7b790;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 12px rgba(77, 72, 53, 0.08);
    }

    .book-cover-wrapper {
        background-color: #e0d5b9;
        border: 1px solid #c7b790;
        border-radius: 8px;
        padding: 12px;
        display: inline-block;
        width: 100%;
        max-width: 320px;
    }

    .book-cover-img {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        border-radius: 4px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .detail-label {
        color: #8a8168;
        font-family: 'Calisto MT', serif;
        font-weight: bold;
    }

    .detail-value {
        color: #4d4835;
        font-family: 'Calisto MT', serif;
    }

    /* Star Rating Modern Theme */
    .star-rating {
        direction: rtl;
        display: inline-block;
        cursor: pointer;
    }

    .star-rating input {
        display: none;
    }

    .star-rating label {
        color: #c7c3ba;
        font-size: 26px;
        padding: 0 3px;
        cursor: pointer;
        transition: transform 0.15s ease, color 0.15s ease;
    }

    .star-rating label:hover,
    .star-rating label:hover~label,
    .star-rating input:checked~label {
        color: #dec676;
    }

    /* Status Buttons Theme */
    .btn-nook-outline {
        border: 1px solid #c7b790;
        color: #4d4835;
        background-color: #faf6ee;
        font-family: 'Calisto MT', serif;
        font-weight: 600;
    }

    .btn-nook-outline:hover, 
    .btn-nook-outline.active {
        background-color: #4d4835 !important;
        color: #faf6ee !important;
        border-color: #4d4835 !important;
    }

    /* Primary Action Buttons */
    .btn-nook-primary {
        background-color: #4d4835;
        color: #faf6ee;
        border: none;
        font-family: 'Calisto MT', serif;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 6px;
        transition: background-color 0.2s;
    }

    .btn-nook-primary:hover {
        background-color: #363325;
        color: #fff;
    }

    .btn-nook-danger {
        background-color: transparent;
        border: 1px solid #c95c5c;
        color: #c95c5c;
        font-family: 'Calisto MT', serif;
        font-weight: 600;
    }

    .btn-nook-danger:hover {
        background-color: #c95c5c;
        color: #fff;
    }

    /* Notes Card */
    .notes-card {
        background-color: #faf6ee;
        border: 1px solid #c7b790;
        border-radius: 10px;
        padding: 1.5rem;
        font-family: 'Calisto MT', serif;
    }

    .notes-text {
        color: #4d4835;
        white-space: pre-wrap;
    }

    .notes-timestamp {
        color: #8a8168;
        font-style: italic;
        display: block;
        margin-top: -0.25rem;
        margin-bottom: 0.5rem;
    }

    .notes-edit-btn {
        background-color: transparent;
        border: 1px solid #4d4835;
        color: #4d4835;
    }

    .notes-edit-btn:hover {
        background-color: #4d4835;
        color: #faf6ee;
    }

    .notes-save-btn {
        background-color: #4d4835;
        color: #faf6ee;
    }

    .notes-save-btn:hover {
        background-color: #363325;
        color: #fff;
    }

    .notes-cancel-btn {
        background-color: transparent;
        border: 1px solid #c7b790;
        color: #8a8168;
    }
</style>

<div class="container my-5" style="font-family: 'Calisto MT', serif">
    <div class="row g-4">
        <!-- Left Column: Cover & Ratings -->
        <div class="col-lg-4 text-center">
            <div class="book-cover-wrapper mb-4">
                <img id="bookCover" src="" alt="Book cover" class="book-cover-img">
            </div>

            <div id="hiddenGrp" class="nook-card d-none">
                <div id="starRating" class="star-rating animated-stars">
                    <input type="radio" id="star5" name="rating" value="5">
                    <label for="star5" class="bi bi-star-fill"></label>
                    <input type="radio" id="star4" name="rating" value="4">
                    <label for="star4" class="bi bi-star-fill"></label>
                    <input type="radio" id="star3" name="rating" value="3">
                    <label for="star3" class="bi bi-star-fill"></label>
                    <input type="radio" id="star2" name="rating" value="2">
                    <label for="star2" class="bi bi-star-fill"></label>
                    <input type="radio" id="star1" name="rating" value="1">
                    <label for="star1" class="bi bi-star-fill"></label>
                </div>
                <p class="small text-muted mt-1 mb-3">Click to rate this book</p>
                
                <button id="removeBtn" class="btn btn-nook-danger btn-sm w-100">Remove from Collection</button>
            </div> 
        </div>

        <!-- Right Column: Info, Status & Notes -->
        <div class="col-lg-8">
            <div class="nook-card mb-4">
                <h1 id="bookTitle" class="shelf-heading mb-1"></h1>
                <h5 id="bookAuthor" class="shelf-book-author mb-4 fs-5"></h5>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <p class="mb-1"><span class="detail-label">Publisher:</span> <span id="bookPublisher" class="detail-value"></span></p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-1"><span class="detail-label">ISBN:</span> <span id="bookIsbn" class="detail-value"></span></p>
                    </div>
                </div>

                <hr style="border-color: #c7b790; opacity: 0.5;">

                <p class="detail-label mb-1">Description:</p>
                <p id="bookDescription" class="detail-value" style="line-height: 1.6;"></p>
            </div>

            <!-- Action Controls & Feedback -->
            <div class="d-flex flex-column gap-3">
                <button id="addToCollectionBtn" class="btn btn-nook-primary btn-lg align-self-start">Add to Collection</button>
                
                <div id="addSuccess" class="alert alert-success d-none mb-0" role="alert"></div>
                <div id="status-feedback" class="alert alert-secondary d-none mb-0" role="alert"></div>
                <div id="addError" class="alert alert-danger d-none mb-0" role="alert"></div>
                
                <div id="bookStatusBtnGrp" class="btn-group d-none w-100" role="group">
                    <button id="wishToReadBtn" class="btn btn-nook-outline active">Wish to Read</button>
                    <button id="currentlyReadingBtn" class="btn btn-nook-outline">Currently Reading</button>
                    <button id="completedBtn" class="btn btn-nook-outline">Completed</button>
                </div>
                
                <div id="notesCardSection" class="notes-card d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="shelf-heading mb-0">My Notes</h4>
                        <button id="editNoteBtn" class="btn btn-sm notes-edit-btn">Edit</button>
                    </div>

                    <p id="noteText" class="notes-text">Click Edit to add your thoughts on this book...</p>
                    <small id="noteTimestamp" class="notes-timestamp d-none"></small>

                    <textarea id="noteTextarea" class="form-control d-none mb-2" rows="4" style="background-color: #faf6ee; border-color: #c7b790; font-family: 'Calisto MT', serif; color: #4d4835;"></textarea>

                    <div class="d-flex gap-2">
                        <button id="saveNoteBtn" class="btn notes-save-btn btn-sm d-none">Save</button>
                        <button id="cancelNoteBtn" class="btn notes-cancel-btn btn-sm d-none">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const isbn = new URLSearchParams(window.location.search).get("isbn");
            const bookId = new URLSearchParams(window.location.search).get("bookId");

            let currentBook = null;
            let fetchUrl;
            let fetchData;

            if (bookId) {
                fetchUrl = "/api/Books/bookDetail/" + bookId;
                fetchData = {};
            } else {
                fetchUrl = "/api/Books/bookDetail";
                fetchData = { isbn: isbn };
            }

            $.ajax({
                url: fetchUrl,
                method: "GET",
                data: fetchData,
                headers: {
                    Authorization: "Bearer " + sessionStorage.getItem("authToken")
                },
                success: function (response) {
                    currentBook = response;

                    $("#bookCover").attr("src", response.thumbnail);
                    $("#bookTitle").text(response.title);
                    $("#bookAuthor").text(response.author);
                    $("#bookPublisher").text(response.publisher);
                    $("#bookDescription").text(response.description);
                    $("#bookIsbn").text(response.isbn);

                    if (response.isInCollection) {
                        $("#addToCollectionBtn").prop("disabled", true).addClass("d-none");
                        $("#hiddenGrp").removeClass("d-none");
                        $("#bookStatusBtnGrp").removeClass("d-none");
                        $("#notesCardSection").removeClass("d-none");
                    }
                },
                error: function (xhr) {
                    console.log("Failed to load book details", xhr.responseJSON);
                }
            });

            $("#addToCollectionBtn").on("click", function () {
                if (!currentBook) return;

                $.ajax({
                    url: "/api/Books/add",
                    method: "POST",
                    contentType: "application/json",
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken")
                    },
                    data: JSON.stringify({
                        title: currentBook.title,
                        author: currentBook.author,
                        publisher: currentBook.publisher,
                        description: currentBook.description,
                        isbn: currentBook.isbn,
                        imagePath: currentBook.thumbnail
                    }),
                    success: function (response) {
                        window.location.href = "/BookData/Details?bookId=" + response.bookId;
                    },
                    error: function (xhr) {
                        $("#addError").removeClass("d-none").text(xhr.responseJSON?.errorMessage ?? "Failed to add book");
                    }
                });
            });
            
            $("#removeBtn").on("click", function () {
                if (!currentBook) return;
                
                $.ajax({
                    url:"/api/UserBooks/delete/" + currentBook.bookId,
                    method: "DELETE",
                    contentType: "application/json",
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken")
                    },
                    data: JSON.stringify({
                        bookId: currentBook.bookId,
                    }),
                    success: function () {
                        $("#addToCollectionBtn").prop("disabled", false).removeClass("d-none");
                        $("#hiddenGrp").addClass("d-none");
                        $("#bookStatusBtnGrp").addClass("d-none");
                        $("#notesCardSection").addClass("d-none"); 
                    },
                    error: function (xhr) {
                        $("#addError").removeClass("d-none").text(xhr.responseJSON?.errorMessage ?? "Failed to remove book");
                    }
                });
            });

            document.querySelectorAll('.star-rating:not(.readonly) label').forEach(star => {
                star.addEventListener('click', function() {
                    this.style.transform = 'scale(1.2)';
                    setTimeout(() => {
                        this.style.transform = 'scale(1)';
                    }, 200);
                });
            });
            
            function getActiveBookId() {
                return currentBook?.bookId || new URLSearchParams(window.location.search).get("bookId");
            }

            function sendPartialUpdate(bookId, payload) {
                if (!bookId) {
                    console.error('PATCH failed: No valid book ID found.');
                    return;
                }

                $('#status-feedback')
                    .removeClass('d-none alert-danger alert-success')
                    .addClass('alert-secondary')
                    .text('Saving changes...');

                $.ajax({
                    url: `/api/UserBooks/update/` + bookId,
                    type: 'PATCH',
                    contentType: 'application/json',
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken")
                    },
                    data: JSON.stringify(payload),
                    success: function (response) {
                        $('#status-feedback')
                            .removeClass('alert-secondary')
                            .addClass('alert-success')
                            .text('Changes saved!');

                        setTimeout(() => {
                            $('#status-feedback').addClass('d-none');
                        }, 2500);
                    },
                    error: function (xhr) {
                        $('#status-feedback')
                            .removeClass('alert-secondary')
                            .addClass('alert-danger')
                            .text('Failed to save changes.');
                        console.error('Patch error:', xhr.responseText);
                    }
                });
            }

            const activeBookId = getActiveBookId();
            if (activeBookId) {
                $.ajax({
                    url: "/api/UserBooks/getInfo/" + activeBookId,
                    method: "GET",
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken")
                    },
                    dataType: "json",
                    success: function (response) {
                        if (response.bookRating) {
                            $(`#starRating input[value="${response.bookRating}"]`).prop('checked', true);
                        }

                        if (response.bookStatus) {
                            $('#bookStatusBtnGrp .status-btn, #bookStatusBtnGrp .btn-nook-outline')
                                .removeClass('active');

                            $('#bookStatusBtnGrp button').filter(function () {
                                return $(this).text().trim().toLowerCase() === response.bookStatus.toLowerCase();
                            }).addClass('active');
                        }

                        if (response.userNote && response.userNote.trim() !== "") {
                            $('#noteText').text(response.userNote);
                            $('#noteTextarea').val(response.userNote);

                            const formattedDate = response.lastEdited
                                ? new Date(response.lastEdited).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
                                : new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

                            $('#noteTimestamp').text("Last edited: " + formattedDate).removeClass('d-none');
                        } else {
                            $('#noteText').text("Click Edit to add your thoughts on this book...");
                            $('#noteTextarea').val("");
                            $('#noteTimestamp').addClass('d-none');
                        }
                    },
                    error: function (xhr) {
                        console.error("Failed to fetch user book feedback:", xhr.responseText);
                    }
                });
            }

            $('#starRating input[type="radio"]').on('change', function () {
                let ratingValue = parseInt($(this).val(), 10);
                sendPartialUpdate(getActiveBookId(), { BookRating: ratingValue });
            });

            $('#bookStatusBtnGrp button').on('click', function () {
                if ($(this).hasClass("active")) return;

                let clickedId = $(this).attr('id');
                let statusText = '';

                if (clickedId === 'wishToReadBtn') {
                    statusText = 'Wish to Read';
                } else if (clickedId === 'currentlyReadingBtn') {
                    statusText = 'Currently Reading';
                } else if (clickedId === 'completedBtn') {
                    statusText = 'Completed';
                }

                $('#bookStatusBtnGrp button').removeClass('active');
                $(this).addClass('active');

                sendPartialUpdate(getActiveBookId(), { BookStatus: statusText });
            });

            $("#editNoteBtn").on("click", function () {
                $("#noteTextarea").val($("#noteText").text() === "Click Edit to add your thoughts on this book..." ? "" : $("#noteText").text());
                $("#noteTextarea, #saveNoteBtn, #cancelNoteBtn").removeClass("d-none");
                $("#noteText, #noteTimestamp, #editNoteBtn").addClass("d-none");
            });

            $("#cancelNoteBtn").on("click", function () {
                $("#noteText, #editNoteBtn").removeClass("d-none");
                if ($("#noteTimestamp").text() !== "") $("#noteTimestamp").removeClass("d-none");
                $("#noteTextarea, #saveNoteBtn, #cancelNoteBtn").addClass("d-none");
            });

            $("#saveNoteBtn").on("click", function () {
                const value = $("#noteTextarea").val().trim();
                $("#noteText").text(value === "" ? "Click Edit to add your thoughts on this book..." : value);

                if (value !== "") {
                    const formatted = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
                    $("#noteTimestamp").text("Last edited: " + formatted).removeClass("d-none");
                }

                $("#noteText, #editNoteBtn").removeClass("d-none");
                $("#noteTextarea, #saveNoteBtn, #cancelNoteBtn").addClass("d-none");

                sendPartialUpdate(getActiveBookId(), { UserNote: value });
            });
        });
    </script>
}