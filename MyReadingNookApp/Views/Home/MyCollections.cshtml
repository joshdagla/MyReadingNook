@{
    Layout = "_Layout";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-start pb-3 border-bottom mb-4">
        <div style="font-family: 'Calisto MT', sans-serif" class="flex-grow-1 me-3">
            <h1  class="h2 fw-bold text-dark mb-0 custom-serif-font">My Collections</h1>
            <p class="text-secondary mb-0 fs-6 custom-serif-font">Browse and manage your reading collections</p>
        </div>

        <div class="flex-shrink-0">
            <button id="addCollectionBtn" type="button" class="btn btn-library-tertiary shadow-sm fw-medium px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Collection
            </button>
        </div>
    </div>

    <div style="font-family: 'Calisto MT', sans-serif" id="collectionInputGrp" class="d-none mb-4">
        <div class="card create-collection-card shadow-sm p-3" style="max-width: 500px;">
            <input class="form-control mb-2" id="collectionName" placeholder="Name of Collection">
            <input class="form-control mb-2" id="collectionDescription" placeholder="Description (Optional)">
            <div class="alert alert-success my-1 d-none" id="collectionSuccess" role="alert" style="padding: 0.25rem 0.5rem;"></div>
            <div class="alert alert-danger my-1 d-none" id="collectionFail" role="alert" style="padding: 0.25rem 0.5rem;"></div>
            <div id="collectionBtnGrp" class="btn-group-sm mt-1 d-flex gap-2">
                <button id="collectionSubmitBtn" type="button" class="btn btn-library-primary btn-sm">Submit</button>
                <button id="cancelBtn" type="button" class="btn btn-library-secondary btn-sm">Cancel</button>
            </div>
        </div>
    </div>

    <div id="collectionsGrid" class="row g-4"></div>
</div>

<style>
    .create-collection-card {
        background-color: #faf6ee;
        border: 1px solid #c7b790 !important;
        border-radius: 10px;
    }

    .create-collection-card input.form-control {
        font-family: 'Calisto MT', serif;
        background-color: #fff;
        border: 1px solid #d9cfb0;
        color: #4d4835;
        border-radius: 6px;
    }

    .create-collection-card input.form-control::placeholder {
        color: #b0a68c;
    }

    .create-collection-card input.form-control:focus {
        border-color: #b9a677;
        box-shadow: 0 0 0 0.2rem rgba(185, 166, 119, 0.25);
    }

    .btn-library-primary {
        background-color: #4d4835;
        border-color: #4d4835;
        color: #faf6ee;
        font-family: 'Calisto MT', serif;
    }

    .btn-library-primary:hover {
        background-color: #3a3626;
        border-color: #3a3626;
        color: #faf6ee;
    }

    .btn-library-secondary {
        background-color: transparent;
        border-color: #c7b790;
        color: #4d4835;
        font-family: 'Calisto MT', serif;
    }

    .btn-library-secondary:hover {
        background-color: #e0d5b9;
        border-color: #c7b790;
        color: #4d4835;
    }

    .btn-library-tertiary {
        background-color: #e0d5b9;
        border-color: #c7b790;
        color: #4d4835;
        font-family: 'Calisto MT', serif;
    }

    .btn-library-tertiary:hover {
        background-color: transparent;
        border-color: #c7b790;
        color: #4d4835;
    }

    .collection-card {
        background-color: #faf6ee !important;
        border: 1px solid #c7b790 !important;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.18s ease-in-out, border-color 0.18s ease-in-out, box-shadow 0.18s ease-in-out;
    }

    .collection-card:hover {
        transform: translateY(-4px);
        border-color: #b9a677;
        box-shadow: 0 8px 18px rgba(77, 72, 53, 0.18);
    }

    .collection-card-body {
        background-color: #faf6ee;
        padding: 1.5rem 1.75rem 0.75rem;
    }

    .collection-card-body h5 {
        font-family: 'Calisto MT', serif;
        font-weight: 700;
        color: #4d4835;
        font-size: 1.3rem;
        margin-bottom: 4px;
    }

    .collection-date {
        font-family: 'Calisto MT', serif;
        font-size: 0.95rem;
        color: #8a8168;
    }

    .book-strip {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        background-color: #e0d5b9;
        padding: 1.1rem 1.75rem;
    }

    .book-strip img {
        width: 90px;
        height: 135px;
        object-fit: cover;
        border-radius: 3px;
        box-shadow: 0 3px 8px rgba(77, 72, 53, 0.3);
        flex-shrink: 0;
    }

    .empty-shelf-msg {
        font-family: 'Calisto MT', serif;
        font-size: 0.85rem;
        color: #b0a68c;
        font-style: italic;
        background-color: #e0d5b9;
        padding: 1.1rem 1.75rem;
    }

</style>

@section Scripts
{
    <script>
        $(document).ready(function () {

            let selectedCollectionId = null;
            
            function loadCollections() {
                $.ajax({
                    url: "/api/BookList/getAll",
                    type: "GET",
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken"),
                    },
                    success: function (collections) {
                        renderCollections(collections);
                    },
                    error: function (response) {
                        console.log("Failed to load collections", response.responseJSON);
                    }
                });
            }

            function renderCollections(collections) {
                const grid = $("#collectionsGrid");
                grid.empty();

                collections.forEach(function (collection) {
                    const dateFormatted = new Date(collection.createdAt).toLocaleDateString("en-US", {
                        year: "numeric", month: "short", day: "numeric"
                    });

                    let bookCoversHtml = "";
                    if (collection.bookCovers && collection.bookCovers.length > 0) {
                        collection.bookCovers.forEach(function (coverUrl) {
                            const cover = coverUrl || "https://via.placeholder.com/60x90?text=No+Cover";
                            bookCoversHtml += `<img src="${cover}" alt="Book cover">`;
                        });
                    }

                    const cardHtml = `
                                    <div class="col-md-6">
                                        <div class="card collection-card h-100">
                                            <div class="collection-card-body">
                                                <h5 class="mb-1">${collection.listName}</h5>
                                                <div class="collection-date">Created ${dateFormatted}</div>
                                            </div>
                                            ${collection.bookCovers && collection.bookCovers.length > 0
                                                    ? `<div class="book-strip">${bookCoversHtml}</div>`
                                                    : `<div class="empty-shelf-msg">No books added yet</div>`}
                                        </div>
                                    </div>
                                `;

                    grid.append(cardHtml);
                    selectedCollectionId = collection.id;
                });
            }

            loadCollections();
            
            
            $(document).on('click', '.collection-card', function () {
                window.location.href = "/BookData/Collection/" + selectedCollectionId
            })

            $("#addCollectionBtn").on("click", function (event) {
                $("#collectionInputGrp").removeClass("d-none");
            });
            $("#cancelBtn").on("click", function (event) {
                $("#collectionInputGrp").addClass("d-none");
            });

            $("#collectionSubmitBtn").on("click", function (event) {
                $.ajax({
                    url: "/api/BookList/create",
                    type: "POST",
                    contentType: "application/json",
                    headers: {
                        Authorization: "Bearer " + sessionStorage.getItem("authToken"),
                    },
                    data: JSON.stringify({
                        name: $("#collectionName").val(),
                        summary: $("#collectionDescription").val(),
                    }),
                    success: function (data) {
                        $("#collectionSuccess").removeClass("d-none").text(`Successfully created collection`);
                        window.location.reload();
                    },
                    error: function (response) {
                        $("#collectionFail").removeClass("d-none").text(`Error creating collection`);
                    }
                });
            });
        })
    </script>
}