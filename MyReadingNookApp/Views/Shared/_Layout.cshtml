<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyReadingNookApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyReadingNookApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body style="background-color: #F1E9D2">

@if (IsSectionDefined("Header"))
{
    @RenderSection("Header", required: false)
    <main role="main" class="container pb-3">
        @RenderBody()
    </main>
}
else
{
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0" style="background-color: #e0d5b9; font-family: 'Calisto MT', sans-serif">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-dark min-vh-100">
                    <a class="d-flex align-items-center pb-3 mb-md-0 me-md-auto mt-4 text-dark text-decoration-none">
                        <img src="~/images/books-stack-of-three.png" alt="Logo" style="max-width: 40px;" class="me-2">
                        <span class="fs-3 d-none d-sm-inline">MyReadingNook</span>
                    </a>

                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index"style="color: black"  class="nav-link align-middle px-0">
                                <i class="fs-3 bi-house"></i> <span class="fs-4 ms-1 d-none d-sm-inline">Book Portal</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="MyBooks" style="color: black" class="nav-link align-middle px-0">
                                <i class="fs-3 bi-book"></i> <span class="fs-4 ms-1 d-none d-sm-inline">My Books</span>
                            </a>
                        </li>
                    </ul>

                    <hr class="text-white w-100">

                    <div class="pb-2 w-60 nav-item">
                        <i class="fs-3 bi bi-arrow-left"></i>
                        <a href="/Account/Login" class="fs-4 d-sm-inline mx-1" style="color: black"  id="logoutBtn">Logout</a>
                    </div>
                </div>
            </div>
            

            <div class="col py-3">
                @RenderBody()
            </div>
            
            
        </div>
    </div>
    
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .nav-item:hover {
        background: #c7b790;
        border-color: #c7b790;
        padding: 3px;
        transition: background-color 0.3s ease-in-out;
        border-radius: 10px;
    }
</style>