@{
    ViewData["Title"] = "Friends";
}

<div class="mb-4">
    <h4 class="fw-bold mb-3" style="color: #4d4835; font-family: 'Calisto MT', serif;">Find Friends</h4>
    <div class="search-container" style="max-width: 500px; position: relative;">
        <input type="text" id="friendSearchInput" class="form-control search-input" placeholder="Search by username...">
        <i class="fas fa-search search-icon"></i>
        <div id="friendSearchResults" class="search-dropdown"></div>
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-bold mb-2" style="color: #4d4835; font-family: 'Calisto MT', serif;">Pending Sent Requests</h5>
    <div id="sentInvitesEmpty" class="text-muted small d-none">No pending requests sent.</div>
    <div id="sentInvitesList"></div>
</div>

<div>
    <h4 class="fw-bold mb-3" style="color: #4d4835; font-family: 'Calisto MT', serif;">My Friends</h4>
    <div id="friendsLoading" class="text-center py-4" style="color: #a89f89;">Loading friends...</div>
    <div id="friendsEmpty" class="text-center py-4 d-none" style="color: #a89f89;">You haven't added any friends yet.</div>
    <div id="friendsList" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3"></div>
</div>

@section CustomWidget {
    <div class="nook-widget p-4 rounded-3 shadow-sm"
         style="background-color: #f5e8cc; border: 1px solid #c7b790; font-family: 'Calisto MT', serif; min-height: 250px;">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0" style="color: #4d4835;">Friend Requests</h4>
            <span id="requestsBadge" class="badge rounded-pill d-none" style="background-color: #b9a677; color: #faf6ee; font-size: 0.8rem;">0</span>
        </div>

        <div id="requestsLoading" class="text-center py-4" style="color: #6b6455; font-size: 0.9rem;">Loading...</div>
        <div id="requestsEmpty" class="text-center py-4 d-none" style="color: #6b6455; font-size: 0.9rem;">No pending requests.</div>
        <div id="requestsList" style="max-height: 320px; overflow-y: auto;"></div>

    </div>
}

<style>
    .friend-card {
        background-color: #faf6ee;
        border: 1px solid #c7b790;
        border-radius: 10px;
        padding: 16px 12px;
        text-align: center;
        transition: transform 0.15s ease-in-out, border-color 0.15s ease-in-out;
    }

    .friend-card:hover {
        transform: translateY(-3px);
        border-color: #b9a677;
    }

    .friend-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #e0d5b9;
        color: #4d4835;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.3rem;
        margin: 0 auto 8px;
    }

    .friend-name {
        font-family: 'Calisto MT', serif;
        font-weight: 700;
        color: #4d4835;
        font-size: 0.95rem;
    }

    .request-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #c7b790;
    }

    .request-row:last-child {
        border-bottom: none;
    }

    .request-name {
        font-family: 'Calisto MT', serif;
        color: #4d4835;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .request-actions button {
        border: none;
        border-radius: 6px;
        font-size: 0.8rem;
        padding: 4px 10px;
        margin-left: 4px;
    }

    .btn-accept {
        background-color: #4d4835;
        color: #faf6ee;
    }

    .btn-decline {
        background-color: #faf6ee;
        color: #4d4835;
        border: 1px solid #c7b790 !important;
    }

    .sent-invite-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #e5ddc8;
        font-family: 'Calisto MT', serif;
        color: #4d4835;
        font-size: 0.9rem;
    }

    .sent-invite-row:last-child {
        border-bottom: none;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            let searchTimeout;

            // ---- Search users ----
            $("#friendSearchInput").on("input", function () {
                clearTimeout(searchTimeout);
                const query = $(this).val().trim();

                if (query.length === 0) {
                    $("#friendSearchResults").empty();
                    return;
                }

                searchTimeout = setTimeout(function () {
                    $.ajax({
                        type: "GET",
                        url: "/api/Friend/userSearch",
                        data: { username: query },
                        headers: {
                            Authorization: "Bearer " + sessionStorage.getItem("authToken"),
                        },
                        success: function (response) {
                            $("#friendSearchResults").empty();

                            if (!response || response.length === 0) {
                                $("#friendSearchResults").append('<div class="p-3 text-muted">No users found.</div>');
                                return;
                            }

                            response.forEach(function (user) {
                                const isPublic = user.profileVisibility === "Public";

                                const statusBadge = isPublic
                                    ? `<span class="alert alert-success py-1 px-2 mb-0" style="font-size: 0.75rem;">Public</span>`
                                    : `<span class="alert alert-danger py-1 px-2 mb-0" style="font-size: 0.75rem;">Private</span>`;

                                const addButton = isPublic
                                    ? `<button class="btn btn-sm btn-dark ms-auto send-request-btn" data-user-id="${user.id}">Send Request</button>`
                                    : "";

                                const resultHtml = `
                                    <div class="search-result-item d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                            <strong>${user.username}</strong>
                                            ${statusBadge}
                                        </div>
                                        ${addButton}
                                    </div>
                                `;
                                $("#friendSearchResults").append(resultHtml);
                            });
                        },
                        error: function (xhr) {
                            $("#friendSearchResults").empty().append('<div class="p-3 text-danger">Search failed.</div>');
                        }
                    });
                }, 400);
            });

            $(document).on("click", function (event) {
                if (!$(event.target).closest(".search-container, #friendSearchResults").length) {
                    $("#friendSearchResults").empty();
                }
            });

            // ---- Send a friend request ----
            $(document).on("click", ".send-request-btn", function () {
                const addresseeId = $(this).data("user-id");
                const btn = $(this);

                $.ajax({
                    type: "POST",
                    url: "/api/Friend/sendInvite",
                    contentType: "application/json",
                    data: JSON.stringify({ addresseeId: addresseeId }),
                    headers: { Authorization: "Bearer " + sessionStorage.getItem("authToken") },
                    success: function () {
                        btn.text("Request Sent").prop("disabled", true);
                        loadSentInvites();
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || "Failed to send request.");
                    }
                });
            });

            // ---- Load received (incoming) requests ----
            function loadReceivedInvites() {
                $.ajax({
                    type: "GET",
                    url: "/api/Friend/receievedInvites",
                    headers: { Authorization: "Bearer " + sessionStorage.getItem("authToken") },
                    success: function (invites) {
                        $("#requestsLoading").addClass("d-none");

                        const pending = (invites || []).filter(i => i.inviteStatus === "Pending");

                        if (pending.length === 0) {
                            $("#requestsEmpty").removeClass("d-none");
                            return;
                        }

                        $("#requestsBadge").text(pending.length).removeClass("d-none");

                        const list = $("#requestsList");
                        pending.forEach(function (invite) {
                            const rowHtml = `
                                <div class="request-row" data-requester-id="${invite.requesterId}">
                                    <span class="request-name">User #${invite.requesterId}</span>
                                    <div class="request-actions">
                                        <button class="btn-accept accept-btn" data-requester-id="${invite.requesterId}">Accept</button>
                                        <button class="btn-decline decline-btn" data-requester-id="${invite.requesterId}">Decline</button>
                                    </div>
                                </div>
                            `;
                            list.append(rowHtml);
                        });
                    },
                    error: function () {
                        $("#requestsLoading").addClass("d-none");
                        $("#requestsEmpty").removeClass("d-none");
                    }
                });
            }

            // ---- Respond to a request (Accept/Decline) ----
            $(document).on("click", ".accept-btn, .decline-btn", function () {
                const row = $(this).closest(".request-row");
                const requesterId = $(this).data("requester-id");
                const isAccept = $(this).hasClass("accept-btn");

                $.ajax({
                    type: "PUT",
                    url: "/api/Friend/reply",
                    contentType: "application/json",
                    data: JSON.stringify({
                        requesterId: requesterId,
                        inviteStatus: isAccept ? "Accepted" : "Rejected"
                    }),
                    headers: { Authorization: "Bearer " + sessionStorage.getItem("authToken") },
                    success: function () {
                        row.remove();
                        if (isAccept) {
                            loadFriends();
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || "Failed to respond to request.");
                    }
                });
            });

            // ---- Load sent (outgoing) requests ----
            function loadSentInvites() {
                $.ajax({
                    type: "GET",
                    url: "/api/Friend/sentInvites",
                    headers: { Authorization: "Bearer " + sessionStorage.getItem("authToken") },
                    success: function (invites) {
                        $("#sentInvitesList").empty();
                        const pending = (invites || []).filter(i => i.inviteStatus === "Pending");

                        if (pending.length === 0) {
                            $("#sentInvitesEmpty").removeClass("d-none");
                            return;
                        }

                        $("#sentInvitesEmpty").addClass("d-none");
                        const list = $("#sentInvitesList");
                        pending.forEach(function (invite) {
                            list.append(`
                                <div class="sent-invite-row">
                                    <span>Request to User #${invite.addresseeId}</span>
                                    <span class="text-muted small">Pending</span>
                                </div>
                            `);
                        });
                    },
                    error: function () {
                        $("#sentInvitesEmpty").removeClass("d-none");
                    }
                });
            }

            // ---- Load friends list ----
            function loadFriends() {
                $.ajax({
                    type: "GET",
                    url: "/api/Friend/myFriends",
                    headers: { Authorization: "Bearer " + sessionStorage.getItem("authToken") },
                    success: function (friends) {
                        $("#friendsLoading").addClass("d-none");
                        $("#friendsList").empty();

                        if (!friends || friends.length === 0) {
                            $("#friendsEmpty").removeClass("d-none");
                            return;
                        }

                        $("#friendsEmpty").addClass("d-none");
                        const list = $("#friendsList");
                        friends.forEach(function (friend) {
                            const initial = friend.friendUsername.charAt(0).toUpperCase();
                            const cardHtml = `
                                <div class="col">
                                    <div class="friend-card">
                                        <div class="friend-avatar">${initial}</div>
                                        <div class="friend-name text-truncate">${friend.friendUsername}</div>
                                    </div>
                                </div>
                            `;
                            list.append(cardHtml);
                        });
                    },
                    error: function () {
                        $("#friendsLoading").addClass("d-none");
                        $("#friendsEmpty").removeClass("d-none");
                    }
                });
            }

            loadReceivedInvites();
            loadSentInvites();
            loadFriends();
        });
    </script>
}